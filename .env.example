# Copy to .env for a local run. Never commit real keys.
# Every provider is optional; with none set the pipeline exits 0 without
# touching src/data or pipeline.

# Google Gemini (default model gemini-2.5-flash)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq (default model openai/gpt-oss-120b)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Cloudflare Workers AI. All three are required; there is no safe default model.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_MODEL=

# OpenRouter. Both are required; there is no safe default model.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=