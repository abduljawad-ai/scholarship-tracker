---
import BaseLayout from '../layouts/BaseLayout.astro'
import { APP_NAME } from '../lib/constants'
---

<BaseLayout
  title={`Page not found | ${APP_NAME}`}
  description="This page does not exist. Browse current scholarships or the archive of closed cycles."
  noindex
>
  <section class="missing" aria-labelledby="not-found-title">
    <div class="missing__stamp" aria-hidden="true">404</div>

    <div class="missing__copy">
      <p class="eyebrow">Missing notice</p>
      <h1 id="not-found-title">Page not found</h1>
      <p class="lede">
        That page does not exist. It may have moved, or the scholarship may have closed and joined
        the archive.
      </p>

      <div class="missing__actions">
        <a class="button--primary" href="/">Browse scholarships</a>
        <a class="button--quiet" href="/archive/">Browse the archive</a>
      </div>

      <p class="missing__note">
        Looking for something you saved? Open <a href="/my-applications/">My Applications</a> —
        the list stays on this device.
      </p>
    </div>
  </section>
</BaseLayout>
