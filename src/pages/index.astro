---
import BaseLayout from '../layouts/BaseLayout.astro'
import { APP_NAME } from '../lib/constants'
---

<BaseLayout
  title={APP_NAME}
  description="An independent guide to comparing scholarships and tracking applications."
  canonicalPath="/"
>
  <section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow">Independent scholarship guidance</p>
    <h1 id="hero-title">Find scholarships with confidence</h1>
    <p class="lede">
      Compare opportunities and keep track of applications in one place. Full listings and guidance
      arrive in a future update; every listing will link back to its official source.
    </p>
  </section>
</BaseLayout>
