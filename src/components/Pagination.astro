---
// Controls are enabled and labelled by home.ts once the result count is known.
---

<nav class="pagination" data-testid="pagination" aria-label="Listing pages" hidden>
  <button type="button" class="button--quiet" data-testid="prev-page" aria-label="Previous page" disabled>
    Previous
  </button>
  <span class="pagination__status" data-testid="page-status" aria-live="polite">Page 1 of 1</span>
  <button type="button" class="button--quiet" data-testid="next-page" aria-label="Next page" disabled>
    Next
  </button>
</nav>
