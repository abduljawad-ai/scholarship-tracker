---
import type { ProgramIndexEntry } from '../lib/filters'
import { formatDate, fundingLabel, studyLevelLabel } from '../lib/format'

interface Props {
  entry: ProgramIndexEntry
  officialUrl?: string
}

const { entry, officialUrl } = Astro.props
const verifiedDeadline = entry.deadlineVerified && entry.nextDeadline !== null
const deadlineMissing = entry.nextDeadline === null
const archived = entry.status === 'archived'
const stampClass = archived
  ? 'stamp stamp--closed'
  : verifiedDeadline
    ? 'stamp stamp--verified'
    : 'stamp stamp--check'
const stampText = archived ? 'Archived' : verifiedDeadline ? 'Verified' : 'Provisional'
---

<article class="register-row" data-program-id={entry.programId} data-testid="listing-card">
  <div class="register-row__inner" data-testid={`card-${entry.programId}`}>
    <div class="register-row__stamp">
      <span class={stampClass}>{stampText}</span>
    </div>

    <div class="register-row__body">
      <h3 class="register-row__title">
        <a href={`/listing/${entry.programId}/`}>{entry.title}</a>
      </h3>
      <p class="register-row__provider">{entry.provider}</p>

      <ul class="register-row__tags" aria-label="Scholarship details">
        {entry.fundedLevels.map((level) => (
          <li class="badge">{studyLevelLabel(level)}</li>
        ))}
        <li class="badge badge--funding">{fundingLabel(entry.fundingType)}</li>
        <li class="badge">{entry.country}</li>
      </ul>

      <p class="register-row__flags">
        <span
          class="badge badge--eligible"
          data-eligible-pill
          hidden={!entry.likelyEligibleFor.includes('bachelor')}
        >
          Likely eligible
        </span>
        {archived && (
          <span class="badge badge--closed" data-testid="closed-badge">Closed</span>
        )}
      </p>

      {archived && officialUrl && (
        <a class="register-row__official" href={officialUrl} rel="noopener noreferrer">
          View official page (closed cycle)
        </a>
      )}
    </div>

    <div class="register-row__deadline">
      {archived ? (
        <span class="slip slip--closed">
          <span class="slip__label">Status</span>
          <span class="slip__date">Applications closed</span>
        </span>
      ) : verifiedDeadline ? (
        <span class="slip">
          <span class="slip__label">Deadline</span>
          <span class="slip__date">
            <time datetime={entry.nextDeadline ?? undefined}>{formatDate(entry.nextDeadline!)}</time>
          </span>
        </span>
      ) : deadlineMissing ? (
        <span class="slip slip--unconfirmed">
          <span class="slip__label">Deadline</span>
          <span class="slip__date">Not listed</span>
          <span class="slip__note">Check official page</span>
        </span>
      ) : (
        <span class="slip slip--unconfirmed">
          <span class="slip__label">Deadline</span>
          <span class="slip__date">Not confirmed</span>
          <span class="slip__note">Check official page</span>
        </span>
      )}
    </div>
  </div>
</article>
